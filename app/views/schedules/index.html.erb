<div class="container mt-4">
  <h1 class="mb-4 fs-5">スケジュール一覧</h1>

  <!-- スケージュール一覧カード -->
  <div class="card shadow-sm mb-4">
    <table class="table table-striped table-hover mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>タイトル</th>
          <th>開始日</th>
          <th>終了日</th>
          <th>終日</th>
          <th>更新日時</th>
          <th></th>
          <th></th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @schedules.each do |schedule| %>
          <tr>
            <td><%= schedule.id %></td>
            <td><%= schedule.title %></td>
            <td><%= schedule.start_date.strftime("%Y/%m/%d") if schedule.start_date.present? %></td>  <!-- yy/mm/dd -->
            <td><%= schedule.end_date.strftime("%Y/%m/%d") if schedule.end_date.present? %></td>      <!-- yy/mm/dd -->
            <td><%= schedule.all_day ? "○" : "" %></td>                                               <!-- ○ or "" -->
            <td><%= schedule.updated_at.strftime("%Y/%m/%d %H:%M") if schedule.updated_at.present? %></td>  <!-- yyyy/mm/dd hh:mm -->
            <td><%= link_to "詳細", schedule_path(schedule), class: "btn btn-secondary btn-sm bi-card-list" %></td>
            <td><%= link_to "編集", edit_schedule_path(schedule), class: "btn btn-success btn-sm bi-pencil-square" %></td>
            <td>
              <%= link_to "削除", schedule_path(schedule),
              data: { turbo_method: :delete, turbo_confirm: "#{schedule.title} を削除しますか？\nこの操作は取り消せません。" },
              class: "btn btn-danger btn-sm bi-trash" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- 合計数/日付カード -->
  <div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between">
      <span>予定合計 : <%= @schedules.count %></span>
      <span>本日の日付 : <%= Date.current.strftime("%Y/%m/%d") %></span>
    </div>
  </div>

  <!-- 新規追加ボタン -->
  <p class="mb-3"><%= link_to "予定を新規追加", new_schedule_path, class: "btn btn-primary bi-plus-lg" %></p>
</div>
