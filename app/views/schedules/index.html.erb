<h1>スケジュール一覧</h1>

<p>予定の合計数 : <%= @schedules.count %></p>
<p>本日の日付 : <%= Date.current.strftime("%Y/%m/%d") %></p>

<p><%= link_to "予定を新規追加する", new_schedule_path %></p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>確認</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.strftime("%Y/%m/%d") if schedule.start_date.present? %></td>  <!-- yy/mm/dd -->
        <td><%= schedule.end_date.strftime("%Y/%m/%d") if schedule.end_date.present? %></td>      <!-- yy/mm/dd -->
        <td><%= schedule.all_day ? "○" : "" %></td>                                               <!-- ○ or "" -->
        <td><%= schedule.updated_at.strftime("%Y/%m/%d %H:%M") if schedule.updated_at.present? %></td>  <!-- yyyy/mm/dd hh:mm -->
        <td><%= link_to "確認", schedule_path(schedule) %></td>
        <td><%= link_to "編集", edit_schedule_path(schedule) %></td>
        <td><%= link_to "削除", schedule_path(schedule), data: { turbo_method: :delete, turbo_confirm: "#{schedule.title} を削除しますか？\nこの操作は取り消せません。" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
