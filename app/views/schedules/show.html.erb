<div class="container mt-4">
  <h1 class="mb-4 fs-5">スケジュール詳細</h1>

  <!-- 詳細表示エリア -->
  <div class="card shadow-sm mb-3">
    <table class="table table-bordered mb-0">
      <tr>
        <th class="bg-light" style="width: 180px;">タイトル</th>
        <td><%= @schedule.title %></td>
      </tr>
      <tr>
        <th class="bg-light" style="width: 180px;">開始日</th>
        <td><%= @schedule.start_date.strftime("%Y/%m/%d") if @schedule.start_date.present? %></td>
      </tr>
      <tr>
        <th class="bg-light" style="width: 180px;">終了日</th>
        <td><%= @schedule.end_date.strftime("%Y/%m/%d") if @schedule.end_date.present? %></td>
      </tr>
      <tr>
        <th class="bg-light" style="width: 180px;">終日</th>
        <td><%= @schedule.all_day ? "○" : "" %></td>
      </tr>
      <tr>
        <th class="bg-light" style="width: 180px;">メモ</th>
        <td style="word-break: break-word; white-space: pre-wrap;"><%= @schedule.memo %></td> <!-- 自動折り返し -->
      </tr>
    </table>
  </div>

  <!-- ボタンエリア -->
  <div class="d-flex justify-content-between mt-3">
    <div>
      <%= link_to "一覧に戻る", schedules_path, class: "btn btn-secondary bi-chevron-compact-left" %>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "編集する", edit_schedule_path(@schedule), class: "btn btn-success bi-pencil-square" %>
      <%= link_to "削除", schedule_path(@schedule), class: "btn btn-danger bi-trash", data: { turbo_method: :delete, turbo_confirm: "#{@schedule.title} を削除しますか？\nこの操作は取り消せません。" } %>
    </div>
  </div>
</div>
