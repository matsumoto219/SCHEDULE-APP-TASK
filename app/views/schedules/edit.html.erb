<h1>スケジュール編集</h1>

<!-- エラー表示 -->
<% if @schedule.errors.any? %>
  <div>
    <h2><%= @schedule.errors.count %>件のエラーがあります。</h2>
    <ul>
      <% @schedule.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @schedule do |f| %>
  <p>
    タイトル<br>
    <%= f.text_field :title %>
  </p>

  <p>
    開始日<br>
    <%= f.date_field :start_date %>
  </p>

  <p>
    終了日<br>
    <%= f.date_field :end_date %>
  </p>

  <p>
    終日<br>
    <%= f.check_box :all_day %>
  </p>

  <p>
    メモ<br>
    <%= f.text_area :memo %>
  </p>

  <p>
    <%= f.submit "更新" %>
  </p>
<% end %>
